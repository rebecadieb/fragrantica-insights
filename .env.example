# Copie para .env e ajuste:  cp .env.example .env
# Os valores de rede abaixo valem para rodar scripts NA SUA MÁQUINA. Dentro do
# docker compose, KAFKA_BOOTSTRAP_SERVERS e DATABASE_URL são sobrescritos para
# os nomes dos serviços (kafka:9092, postgres:5432).

# --- LLM ---------------------------------------------------------------------
# anthropic = Claude via API (precisa de ANTHROPIC_API_KEY e créditos). Sem a chave, o app
#             abre em MODO LEITURA: mostra as análises salvas (ex.: `make restaurar`) e coleta
#             reviews, mas não gera análises novas.
# ollama    = modelo open source rodando na sua máquina (grátis, sem chave; ver README)
# demo      = heurística sem IA, só para testar o fluxo
LLM_PROVEDOR=anthropic

# --- Ollama (LLM_PROVEDOR=ollama) ---------------------------------------------
OLLAMA_MODELO=qwen2.5:3b
# Opcional: outro modelo só para a síntese do modo detalhado (o texto final; 1 chamada por perfume).
# Ex.: extração com qwen2.5:3b (rápido) e síntese com qwen2.5:7b (português melhor).
OLLAMA_MODELO_SINTESE=
OLLAMA_NUM_CTX=8192
# um modelo local é mais lento: lê menos reviews por análise, em lotes menores
OLLAMA_MAX_REVIEWS=40
OLLAMA_REVIEWS_POR_LOTE=10
OLLAMA_PARALELO=1
# tempo máximo de cada chamada ao modelo local (segundos)
OLLAMA_TIMEOUT_S=600
# endereço usado pelo app DENTRO do Docker (padrão: Ollama instalado no Mac/Windows)
# OLLAMA_URL_DOCKER=http://host.docker.internal:11434
# endereço usado por scripts rodando fora do Docker
OLLAMA_URL=http://localhost:11434

# --- Claude (LLM_PROVEDOR=anthropic) -------------------------------------------
# Uma linha só com a chave (sem aspas, sem espaços); vazia = modo leitura.
ANTHROPIC_API_KEY=
# Estágio 1 (classificar reviews em lote) usa um modelo mais barato;
# estágio 2 (nota + resumo + perfil) usa um modelo mais capaz.
LLM_MODELO_EXTRACAO=claude-haiku-4-5-20251001
LLM_MODELO_SINTESE=claude-sonnet-5
LLM_REVIEWS_POR_LOTE=40
LLM_MAX_REVIEWS=100
MIN_REVIEWS_ANALISE=5
# Modo da análise: detalhado (lotes + síntese; ~2 a 4 min com 40 reviews no qwen2.5:3b) ou
# rapido (1 chamada; com modelos pequenos pula reviews; use só com modelos maiores).
MODO_ANALISE_APP=detalhado
MODO_ANALISE_ANALISTA=detalhado
# Envia ao modelo só as frases que falam de alguma dimensão (menos texto, mais rápido)
FILTRAR_FRASES=true

# --- Coleta diária -------------------------------------------------------------
TZ=America/Fortaleza
HORARIO_COLETA=03:00
COLETAR_AO_INICIAR=false
# Catálogo: marcas do ranking "Marcas Mais Populares" e de quanto em quanto tempo
# procurar perfumes novos nelas (o coletor monta o catálogo sozinho se o banco estiver vazio)
MAX_MARCAS=60
ATUALIZAR_CATALOGO_DIAS=7
# Coleta sob demanda (perfume escolhido no app): reviews com mais de N dias são
# atualizadas antes da análise; o app espera até ESPERA_COLETA_S pela coleta.
VALIDADE_COLETA_DIAS=7
ESPERA_COLETA_S=600
MAX_PRODUTOS_POR_COLETA=200
MAX_CLIQUES_REVIEWS=100
SCRAPER_HEADLESS=false

# --- Analista automático (serviço `analista`) ------------------------------------
# Analisa sozinho os perfumes com reviews novas (os mais populares primeiro), um por vez,
# e PAUSA quando alguém pede uma análise no app. Janela vazia = o dia todo;
# "22:00" e "07:00" = só de madrugada (pode virar a noite).
ANALISTA_INICIO=
ANALISTA_FIM=
ANALISTA_MAX_REVIEWS=100
ANALISTA_MAX_POR_DIA=50
ANALISTA_ESPERA_S=300
# Com LLM_PROVEDOR=anthropic (pago) o analista fica desligado, a não ser que você ligue:
ANALISTA_PERMITIR_PAGO=false

# --- ETL -----------------------------------------------------------------------
ANONIMIZAR_AUTORES=true
MIN_PALAVRAS_INFORMATIVA=5

# --- Infraestrutura (execução local fora do compose) ---------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
DATABASE_URL=postgresql://fragrantica:fragrantica@localhost:5432/fragrantica
TOPICO_PRODUTOS=fragrantica.produtos
TOPICO_REVIEWS=fragrantica.reviews
TOPICO_PEDIDOS=fragrantica.pedidos
TOPICO_STATUS=fragrantica.pedidos.status
TOPICO_DLQ=fragrantica.dlq
KAFKA_PARTICOES=3
KAFKA_CONSUMER_GROUP=fraginsights-ingestao
